DATABASE_URL=

# "ollama" runs fully locally and needs no API key or paid account.
# "anthropic" / "openai" are optional, for future use — see README.
AI_PROVIDER=ollama

# Only used when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_MS=120000

# Only used when AI_PROVIDER=anthropic or openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000
